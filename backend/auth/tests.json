{
  "tests": [
    {
      "name": "Register new user",
      "method": "POST",
      "path": "/?action=register",
      "body": {
        "username": "testuser99",
        "email": "testuser99@example.com",
        "password": "password123",
        "country": "Россия"
      },
      "expectedStatus": 200,
      "expectedBody": {"token": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Login with username",
      "method": "POST",
      "path": "/?action=login",
      "body": {
        "login": "testuser99",
        "password": "password123"
      },
      "expectedStatus": 200,
      "expectedBody": {"token": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Login wrong password",
      "method": "POST",
      "path": "/?action=login",
      "body": {
        "login": "testuser99",
        "password": "wrongpass"
      },
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    }
  ]
}